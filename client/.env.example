# Copy to client/.env (gitignored) for local development.
# CARTO raster basemap API key — removes the "API key required" watermark on the
# check-in map. Staging/prod builds must export this variable at build time
# (Vite bakes it into the bundle), e.g.:
#   VITE_CARTO_API_KEY=cb1_xxx npm run build --prefix client
# Never commit the real key.
VITE_CARTO_API_KEY=
