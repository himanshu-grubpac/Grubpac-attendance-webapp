{
  "name": "attendance-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "seed:wipe": "node src/seed.js --wipe",
    "seed:holidays": "node src/seedIndiaHolidays.js",
    "wipe:keep-holidays-geo": "node src/wipeKeepHolidaysGeo.js",
    "migrate": "node src/migrateRecentFeatures.js",
    "migrate:dual-portal": "node src/migrateDualPortal.js",
    "test": "node --test src/**/*.test.js",
    "test:e2e": "node scripts/e2e-password-reset.mjs",
    "test:e2e:auto-checkout": "node scripts/e2e-auto-checkout.mjs",
    "test:e2e:job-lock": "node scripts/e2e-job-lock.mjs",
