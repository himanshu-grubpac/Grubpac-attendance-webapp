# Staging environment — copy to .env.staging locally (gitignored) for CLI seed/migrate/jobs.
# Do NOT commit real credentials. Values below are placeholders only.

PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@attendance-staging.ivyl6lu.mongodb.net/attendance_web?appName=attendance-staging
JWT_SECRET=REPLACE_ME_STAGING_JWT_MIN_32_CHARS
JWT_EXPIRES_IN=12h
JWT_COOKIE_MAX_AGE_MS=43200000
CLIENT_ORIGIN=https://d24p2zn8763d4h.cloudfront.net
# Base URL of the API used inside email action links (defaults to CLIENT_ORIGIN when empty).
API_ORIGIN=https://d24p2zn8763d4h.cloudfront.net
LEAVE_DECISION_TOKEN_TTL_MS=172800000
LEAVE_DECISION_UNDO_MS=15000
ADMIN_EMAIL=admin@grubpac.com
ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
# System PIN is strictly 4 digits.
ADMIN_PIN=1234
ADMIN_NAME=Grubpac Admin
DEFAULT_OFFICE_NAME=Grubpac Technologies - Jhandewalan Office
DEFAULT_OFFICE_LAT=28.647284
DEFAULT_OFFICE_LNG=77.202835
DEFAULT_OFFICE_RADIUS_METERS=100
DEFAULT_MAX_ACCURACY_METERS=100
DEFAULT_OFFICE_START_TIME=09:00
DEFAULT_OFFICE_END_TIME=17:00
DEFAULT_WARNING_THRESHOLD_TIME=09:00
DEFAULT_HALF_DAY_THRESHOLD_TIME=10:00
DEFAULT_WARNINGS_PER_QUARTER=3
# ── Auto-checkout tuning (used when the office-settings doc is first created) ──
AUTO_CHECKOUT_ENABLED=true
AUTO_CHECKOUT_OFFICE_DAY=same
AUTO_CHECKOUT_OFFICE_TIME=23:59
AUTO_CHECKOUT_WFH_DAY=next
AUTO_CHECKOUT_WFH_TIME=06:00
# ── AWS S3 (help-ticket file uploads) ──
AWS_REGION=ap-south-1
UPLOADS_BUCKET=grubpac-attendance-help-uploads-staging-662252246711
UPLOADS_PREFIX=help-tickets
UPLOAD_MAX_BYTES=5242880
# ── Email (password reset + leave decision links) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
EMAIL_FROM=REPLACE_ME
EMAIL_FROM_NAME=Grubpac Attendance
PASSWORD_RESET_EXPIRES_MS=300000
# ── Brevo transactional SMS (optional) ──
BREVO_API_KEY=REPLACE_ME
SMS_SENDER=GRUBPAC
SMS_DEFAULT_COUNTRY_CODE=91
# ── WhatsApp (optional, OFF by default) ──
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_NAME=grubpac-wa
