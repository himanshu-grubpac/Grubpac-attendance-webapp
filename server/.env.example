PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/attendance_web
JWT_SECRET=change-this-to-a-long-random-secret
# Token lifetime — keep in sync with JWT_COOKIE_MAX_AGE_MS so the cookie and token expire together (default 12h).
JWT_EXPIRES_IN=12h
# Auth cookie lifetime in ms — keep equal to JWT_EXPIRES_IN so the cookie and token expire together (default 12h).
JWT_COOKIE_MAX_AGE_MS=43200000
CLIENT_ORIGIN=http://localhost:5173
# Base URL of the API server used inside email action links (defaults to CLIENT_ORIGIN).
API_ORIGIN=http://localhost:3000
# TTL (ms) for single-use email approve/reject tokens (default 48h).
LEAVE_DECISION_TOKEN_TTL_MS=172800000
# Undo window (ms) before a leave decision is finalized and mailed (default 15s).
LEAVE_DECISION_UNDO_MS=15000
ADMIN_EMAIL=admin@grubpac.com
ADMIN_PASSWORD=change-me-admin-password
# Seed admin 4-digit PIN for PIN login (default 1234 — change immediately).
ADMIN_PIN=1234
ADMIN_NAME=Grubpac Admin
DEFAULT_OFFICE_NAME=Grubpac Technologies - Jhandewalan Office
DEFAULT_OFFICE_LAT=28.647284
DEFAULT_OFFICE_LNG=77.202835
DEFAULT_OFFICE_RADIUS_METERS=100
DEFAULT_MAX_ACCURACY_METERS=100
DEFAULT_OFFICE_START_TIME=09:00
DEFAULT_OFFICE_END_TIME=17:00
DEFAULT_WARNING_THRESHOLD_TIME=09:00
DEFAULT_HALF_DAY_THRESHOLD_TIME=10:00
DEFAULT_WARNINGS_PER_QUARTER=3
# DEVICE_CONFLICT_WINDOW_MS=86400000
# USE_MEMORY_DB=true
# ── Auto-checkout tuning (used when the office-settings doc is first created) ──
# AUTO_CHECKOUT_ENABLED=true
# AUTO_CHECKOUT_OFFICE_DAY=same
# AUTO_CHECKOUT_OFFICE_TIME=23:59
# AUTO_CHECKOUT_WFH_DAY=next
# AUTO_CHECKOUT_WFH_TIME=06:00
## ── AWS S3 (file uploads) ─────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost.floci.io:4566
UPLOADS_BUCKET=my-bucket
UPLOADS_PREFIX=help-tickets
UPLOAD_MAX_BYTES=5242880
# ── Email (password reset magic links) ───────────────────────────────
# SMTP transport used by the password-reset email (Brevo/Sendinblue).
# Leave SMTP_HOST empty to fall back to console logging (development only).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=
EMAIL_FROM=REPLACE_ME
EMAIL_FROM_NAME=Grubpac Attendance
# Password-reset magic link lifetime in milliseconds (default 5 minutes).
PASSWORD_RESET_EXPIRES_MS=300000

# Brevo transactional SMS (optional). Requires a Brevo API key (SMTP & API section), not the SMTP password.
BREVO_API_KEY=
SMS_SENDER=GRUBPAC
SMS_DEFAULT_COUNTRY_CODE=91

# WhatsApp (open-wa / WhatsApp Web) — optional, OFF by default.
# Sends from the app's OWN WhatsApp number via WhatsApp Web (zero per-message cost,
# but unofficial -> WhatsApp ToS/ban risk). Only users who opted in (User.whatsappOptIn)
# ever receive WhatsApp messages. Requires `@open-wa/wa-automate` installed and a one-time
# QR scan (printed to server console) to establish the session.
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_NAME=grubpac-wa
# WHATSAPP_CHROME_PATH=/path/to/chrome  # optional, only if bundled Chromium is unavailable
