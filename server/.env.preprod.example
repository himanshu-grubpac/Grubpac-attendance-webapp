# Pre-prod (UAT) environment — copy to .env.preprod locally (gitignored) for CLI seed/migrate/jobs.
# Atlas project: GrubPac Attendance Pre-Prod — cluster attendance-preprod (NOT staging, NOT prod).
# Do NOT commit real credentials.
#
# Mongo connection (match staging/prod local env pattern):
#   mongodb+srv://USER:PASSWORD@attendance-preprod.wtj7gte.mongodb.net/attendance_web?appName=attendance-preprod
# Copy host/user/pass from Atlas Connect → Drivers → Node.js (SRV string). Same URI goes in samconfig.preprod.toml MongoDbUri.
# Local CLI on Windows: run scripts with node --env-file=.env.preprod; they must call connectDatabase() from src/config/db.js.
# Avoid Atlas "Standard connection string" for local scripts — manual replicaSet names often fail (ReplicaSetNoPrimary).

PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@attendance-preprod.wtj7gte.mongodb.net/attendance_web?appName=attendance-preprod
JWT_SECRET=REPLACE_ME_PREPROD_JWT_MIN_32_CHARS
JWT_EXPIRES_IN=12h
JWT_COOKIE_MAX_AGE_MS=43200000
CLIENT_ORIGIN=https://REPLACE_PREPROD_CLOUDFRONT_DOMAIN
API_ORIGIN=https://REPLACE_PREPROD_CLOUDFRONT_DOMAIN
LEAVE_DECISION_TOKEN_TTL_MS=172800000
LEAVE_DECISION_UNDO_MS=15000
LEAVE_SUBMIT_UNDO_WINDOW_MS=10000
LEAVE_NOTIFICATION_DELAY_MS=2500
LEAVE_FINALIZE_QUEUE_URL=
